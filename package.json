{
  "name": "wayfarer-ai-travel",
  "version": "1.0.0",
  "private": true,
  "description": "Wayfarer — an AI-powered travel advisor: destinations, reviews, trip planning and a travel concierge.",
  "scripts": {
    "dev": "node scripts/run-next.cjs dev --webpack",
    "build": "node scripts/run-next.cjs build --webpack",
    "start": "node scripts/run-next.cjs start",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/domain.test.mts",
    "typecheck": "tsc --noEmit",
    "data:fetch": "node scripts/fetch-wiki.mjs",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/seed.ts --reset"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "better-sqlite3": "^13.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.49.0",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.9"
  }
}
