# ─── Wayfarer configuration ─────────────────────────────────────────────
# Copy to .env.local and fill in what you need. Everything is optional:
# without an Anthropic key the app runs on its built-in local AI engine.

# Claude API key (https://console.anthropic.com). Enables Claude-powered
# concierge chat, itinerary writing, review summaries, owner replies, etc.
ANTHROPIC_API_KEY=

# Model used for AI features (default: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# AI provider: "auto" (Claude when a key is present, else local), "claude", or "local"
# AI_PROVIDER=auto

# Token prices (USD per million) used by the admin revenue dashboard's AI-cost estimate.
# Defaults are Claude Opus 5.5 list prices.
# AI_COST_INPUT_PER_MTOK=4
# AI_COST_OUTPUT_PER_MTOK=20

# SQLite database location (default: ./data/wayfarer.db)
# DATABASE_PATH=./data/wayfarer.db

# Public base URL, used in sitemap.xml and robots.txt
# SITE_URL=https://wayfarer.example.com

# Set to true when serving over HTTPS: marks cookies Secure and enables HSTS
# COOKIE_SECURE=false

# Secret for signing partner click-out links (min 16 chars). If unset, a random
# secret is generated once and stored in the database.
# APP_SECRET=

# Billing mode. "demo" (default) activates plans without taking payment.
# "live" disables demo checkout until a payment provider is wired in.
# PAYMENTS_MODE=demo

# Demo conveniences such as showing listing verification codes on screen.
# Set to false for a real launch (codes must then be sent by SMS or email).
# DEMO_MODE=true
